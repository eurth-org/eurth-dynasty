---
// A family tree drawn into the page at build time, from our own examples. It carries class
// names instead of colours (see paintClasses in render.ts), and the rules below give each class
// its token, so the drawing follows the theme. Wide trees scroll inside their own box.
import type { Tree } from '../dynasty/model';
import { treeSvg } from '../dynasty/render';

interface Props {
  tree: Tree;
  /** Unique on the page: it names the drawing's title and description. */
  id: string;
}
const { tree, id } = Astro.props;
const svg = treeSvg(tree, { classes: true, idPrefix: id, heading: false });
---

<div class="eu-scroll drawing" tabindex="0" role="group" aria-label="Family tree. It scrolls sideways.">
  <Fragment set:html={svg} />
</div>

<style is:global>
  .drawing {
    padding: var(--space-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .drawing svg {
    display: block;
  }

  .dy-f-surface { fill: var(--surface); }
  .dy-s-surface { stroke: var(--surface); }
  .dy-f-surface-raised { fill: var(--surface-raised); }
  .dy-s-surface-raised { stroke: var(--surface-raised); }
  .dy-f-ink { fill: var(--ink); }
  .dy-s-ink { stroke: var(--ink); }
  .dy-f-ink-muted { fill: var(--ink-muted); }
  .dy-s-ink-muted { stroke: var(--ink-muted); }
  .dy-f-line-strong { fill: var(--line-strong); }
  .dy-s-line-strong { stroke: var(--line-strong); }
  .dy-f-accent-text { fill: var(--accent-text); }
  .dy-s-accent-text { stroke: var(--accent-text); }
  .dy-f-crown { fill: var(--caution-text); }
  .dy-s-crown { stroke: var(--caution-text); }
</style>
