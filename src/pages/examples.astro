---
// Examples: ready-made houses, each a link into the tree. The links and the pictures are made
// at build time with the same code the tool uses, so they can never drift apart.
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
import { describeTree } from '../dynasty/describe';
import { examples } from '../dynasty/examples';
import { encodeTree, LINK_PARAM } from '../dynasty/link';
import { lawNames } from '../dynasty/model';
import { drawingLayout, HEADING_HEIGHT, treeSvg } from '../dynasty/render';
import { paletteFor } from '../ui/palette';

const palette = paletteFor('dark');
const cards = examples.map((example) => {
  const layout = drawingLayout(example.tree);
  return {
    ...example,
    href: `/?${LINK_PARAM}=${encodeTree(example.tree)}`,
    picture: `data:image/svg+xml;charset=utf-8,${encodeURIComponent(treeSvg(example.tree, { palette, layout }))}`,
    width: layout.width,
    height: layout.height + HEADING_HEIGHT,
    alt: describeTree(example.tree),
  };
});
---

<Page
  site={site}
  title="Example royal family trees"
  description="Six fictional royal and noble houses to start from, one for each succession law and one with every exclusion. Open one in the tree and make it yours."
  crumbs={[{ name: 'Examples', path: '/examples/' }]}
>
  <div class="eu-stack">
    <header class="eu-prose">
      <p class="eu-kicker">Examples</p>
      <h1>Example royal family trees</h1>
      <p class="eu-lead">
        Six invented houses, one for each succession law and one where every house rule bites. Open one in the <a href="/">tree</a> and change what you like; the
        <a href="/guide/">guide</a> explains why each line runs the way it does.
      </p>
    </header>
    <ul class="gallery">
      {
        cards.map((card) => (
          <li>
            <a class="eu-card" href={card.href}>
              <img src={card.picture} alt={card.alt} width={card.width} height={card.height} loading="lazy" />
              <h2>{card.tree.house}</h2>
              <p class="eu-muted">
                {[card.tree.realm, lawNames[card.tree.law]].filter(Boolean).join(' · ')}
              </p>
              <p>{card.blurb}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Page>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  .gallery h2 {
    font: var(--type-heading);
  }
</style>
