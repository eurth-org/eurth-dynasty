---
// Examples: six invented houses, each a link into the tool. The links are made at build time
// with the same code the tool uses, so they can never drift apart.
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
import TreeFigure from '../components/TreeFigure.astro';
import { withThe } from '../dynasty/describe';
import { examples } from '../dynasty/examples';
import { encodeTree, LINK_PARAM } from '../dynasty/link';
import { displayName, indexTree, lawNames } from '../dynasty/model';
import { lineOfSuccession } from '../dynasty/succession';

const shown = examples.map((example) => {
  const index = indexTree(example.tree);
  const succession = lineOfSuccession(example.tree);
  const name = (id: string | undefined) => displayName(id === undefined ? undefined : index.person.get(id));
  return {
    ...example,
    href: `/?${LINK_PARAM}=${encodeTree(example.tree)}`,
    reigning: name(succession.reigning),
    heir: name(succession.heir),
    people: example.tree.people.length,
  };
});
---

<Page
  site={site}
  title="Example family trees and successions"
  description="Six invented royal and noble houses to open and change: a daughter who inherits, a duke with only daughters, brothers before sons, an elected king and more."
  crumbs={[{ name: 'Examples', path: '/examples/' }]}
>
  <div class="eu-stack">
    <header class="eu-prose">
      <p class="eu-kicker">Examples</p>
      <h1>Example family trees and successions</h1>
      <p class="eu-lead">
        Six invented houses, one for each way a crown can pass. Open one in the <a href="/">tree</a> and change what you like: marry someone off, switch the
        law, see who is left standing. The <a href="/guide/">guide</a> explains the laws and the <a href="/glossary/">glossary</a> the words.
      </p>
    </header>
    <ul class="houses">
      {
        shown.map((example) => (
          <li class="eu-card">
            <h2>
              {example.tree.house}
              <span class="eu-muted">{example.tree.realm}</span>
            </h2>
            <p>{example.blurb}</p>
            <TreeFigure tree={example.tree} id={`example-${example.id}`} label={`Family tree of ${withThe(example.tree.house)}`}>
              {lawNames[example.tree.law]}. {example.reigning} reigns; {example.tree.law === 'elective' ? 'the first choice' : 'the heir'} is {example.heir}.{' '}
              {example.people} people.
            </TreeFigure>
            <p>
              <a class="eu-btn" href={example.href}>
                Open the {example.tree.house} in the tree
              </a>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</Page>

<style>
  .houses {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    font: var(--type-subtitle);
  }

  h2 span {
    font: var(--type-body);
  }
</style>
