---
// The glossary: each term has an id to link to, and the whole set is given to search engines
// as a DefinedTermSet.
import { definedTermSet } from '@eurth/style/build';
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
import { glossary, termById } from '../content/glossary';

const title = 'Glossary of succession and genealogy terms';
---

<Page
  site={site}
  title={title}
  description={`${glossary.length} words of royal succession and family trees, explained in a sentence or two each: from abdication and agnate to tanistry and usurper.`}
  crumbs={[{ name: 'Glossary', path: '/glossary/' }]}
  jsonld={[definedTermSet(site, { name: title, path: '/glossary/', terms: glossary.map(({ id, term, definition }) => ({ id, term, definition })) })]}
>
  <article class="eu-prose">
    <p class="eu-kicker">Glossary</p>
    <h1>{title}</h1>
    <p class="eu-lead">
      The words of crowns and family trees, in a sentence or two each. The <a href="/guide/">guide</a> shows how they fit together, the
      <a href="/examples/">examples</a> show them at work, and the <a href="/">tree</a> is where you use them.
    </p>
    <dl>
      {
        glossary.map((entry) => (
          <>
            <dt id={entry.id}>{entry.term}</dt>
            <dd>
              {entry.definition}
              {entry.see?.length ? (
                <span class="see">
                  {' '}
                  See also{' '}
                  {entry.see.map((id, i) => (
                    <>
                      {i > 0 && (i === entry.see!.length - 1 ? ' and ' : ', ')}
                      <a href={`#${id}`}>{termById(id)!.term.toLowerCase()}</a>
                    </>
                  ))}
                  .
                </span>
              ) : null}
            </dd>
          </>
        ))
      }
    </dl>
  </article>
</Page>

<style>
  dt {
    margin-top: var(--space-4);
    font: var(--type-heading);
    scroll-margin-top: var(--space-16);
  }

  dd {
    margin: var(--space-1) 0 0;
  }

  .see {
    color: var(--ink-muted);
  }
</style>
